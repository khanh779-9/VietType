<UserControl x:Class="VietType.Pages.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VietType.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">
            <TextBlock Text="Gõ tắt" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Quản lý danh sách từ khóa viết tắt và cấu hình tự động mở rộng cụm từ." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,14"/>

            <!-- Card 1: Thiết lập tính năng gõ tắt -->
            <controls:SettingCard Title="Tùy chọn gõ tắt">
                <StackPanel>
                    <CheckBox x:Name="EnableShortcutsCheck" Content="Bật tính năng gõ tắt" FontWeight="SemiBold" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14,10" Margin="0,2,0,0">
                        <StackPanel>
                            <CheckBox x:Name="ShortcutWithoutSpaceCheck" Content="Cho phép gõ tắt không cần phím cách (Tự động thay thế ngay khi gõ xong)" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,2,0,6"/>
                            <CheckBox x:Name="ShortcutWhenOffCheck" Content="Vẫn cho phép gõ tắt ngay cả khi bộ gõ tiếng Việt đang Tắt [E]" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,2,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:SettingCard>

            <!-- Card 2: Bảng danh sách từ gõ tắt -->
            <controls:SettingCard Title="Danh sách từ khóa gõ tắt (Macro)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Bảng DataGrid -->
                    <StackPanel Grid.Column="0">
                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <TextBlock Text="Bảng gõ tắt hiện hành" Style="{StaticResource FieldLabelStyle}"/>
                        </DockPanel>
                        <DataGrid x:Name="ShortcutGrid" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  HeadersVisibility="Column" 
                                  SelectionChanged="ShortcutGrid_SelectionChanged" 
                                  MinHeight="260" MaxHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Từ khóa" Binding="{Binding Trigger}" Width="120"/>
                                <DataGridTextColumn Header="Nội dung thay thế" Binding="{Binding Replacement}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Cột phải: Form nhập liệu & hành động -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Từ khóa viết tắt" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ShortcutTriggerBox"/>

                        <TextBlock Text="Nội dung thay thế" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                        <TextBox x:Name="ShortcutReplacementBox" AcceptsReturn="True" Height="85" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <!-- Nhóm nút hành động -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddButton" Grid.Column="0" Content="Thêm" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"/>
                            <Button x:Name="SaveButton" Grid.Column="1" Content="Lưu" Click="Save_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="2,0,2,0"/>
                            <Button x:Name="DeleteButton" Grid.Column="2" Content="Xóa" Click="Delete_Click" Style="{StaticResource DangerButtonStyle}" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Gợi ý hướng dẫn nhỏ -->
                        <Border Margin="0,16,0,0" Padding="10,8" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6">
                            <TextBlock Text="💡 Mẹo: Nhấp chuột vào một dòng trong danh sách để xem, chỉnh sửa hoặc xóa từ gõ tắt." 
                                       Foreground="{DynamicResource MutedTextBrush}" 
                                       FontSize="11" 
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:SettingCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
