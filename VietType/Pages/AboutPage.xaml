<UserControl x:Class="VietType.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">
            <TextBlock Text="Về VietType" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Thông tin về bộ gõ và dự án." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,14"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                            <Path Width="25" Height="25" Stretch="Uniform" Fill="White" Data="{StaticResource IconApp}"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="VietType" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Bộ gõ tiếng Việt cho Windows" Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,16,0,14" Background="{DynamicResource BorderBrushSoft}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tác giả" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="Tran Khanh (Khanh779-9)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Nền tảng" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="WPF / .NET 8 / Windows" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Text="Giao diện" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Light / Dark / Auto" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Về phiên bản này" Style="{StaticResource CardCaptionStyle}"/>
                    <TextBlock Text="Phiên bản WPF .NET 8 được tổ chức lại theo cấu trúc XAML rõ ràng, tách page và custom control để dễ bảo trì." Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>