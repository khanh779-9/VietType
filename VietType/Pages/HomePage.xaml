<UserControl x:Class="VietType.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VietType.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,22">
            <TextBlock Text="Bộ gõ tiếng Việt" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Cấu hình nhanh và kiểm tra bộ gõ." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,14"/>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Bộ gõ tiếng Việt" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Bật / tắt bộ gõ trên toàn hệ thống" Style="{StaticResource SmallMutedTextStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <controls:ToggleSwitch x:Name="ToggleEnabled" Grid.Column="1" IsOn="True" Toggled="ToggleEnabled_Toggled"/>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kiểu gõ" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="TypingMethodCombo" SelectionChanged="TypingMethodCombo_SelectionChanged">
                                <ComboBoxItem Content="Telex"/><ComboBoxItem Content="VNI"/><ComboBoxItem Content="VIQR"/><ComboBoxItem Content="Telex mở rộng"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bảng mã" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CodeTableCombo" SelectionChanged="CodeTableCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ShowWindowAtStartupCheck" Content="Hiện cửa sổ khi khởi động" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="1" Content="Khởi động cùng Windows" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    </Grid>

                    <Border Grid.Row="5" Grid.ColumnSpan="2" Padding="10" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock Text="Thử nhanh" Style="{StaticResource CardCaptionStyle}"/>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="PreviewInput" Height="58" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="PreviewInput_TextChanged" ToolTip="Nhập nội dung để thử bộ gõ"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="9">
                                    <TextBlock x:Name="PreviewOutput" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <DockPanel LastChildFill="False" Margin="0,10,0,8">
                <TextBlock Text="Phím tắt nhanh" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                <Button x:Name="CustomizeHotkeysButton" DockPanel.Dock="Right" Content="Thiết lập chi tiết →" Click="CustomizeHotkeys_Click" Style="{StaticResource LinkButtonStyle}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Bật / tắt E/V -->
                <Border Style="{StaticResource CompactCardStyle}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Bật / tắt bộ gõ (E/V)" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="QuickToggleHotkeyCombo" SelectionChanged="QuickToggleCombo_Changed">
                            <ComboBoxItem Content="Ctrl + Shift"/>
                            <ComboBoxItem Content="Alt + Z"/>
                            <ComboBoxItem Content="Ctrl + ~"/>
                            <ComboBoxItem Content="Win + Space"/>
                            <ComboBoxItem Content="Tùy chỉnh..."/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Card 2: Chuyển kiểu gõ -->
                <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Chuyển kiểu gõ" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="QuickMethodHotkeyCombo" SelectionChanged="QuickMethodCombo_Changed">
                            <ComboBoxItem Content="Alt + Z"/>
                            <ComboBoxItem Content="Alt + Shift + Z"/>
                            <ComboBoxItem Content="Ctrl + Shift + F"/>
                            <ComboBoxItem Content="(Tắt)"/>
                            <ComboBoxItem Content="Tùy chỉnh..."/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Card 3: Phục hồi từ gốc -->
                <Border Grid.Column="4" Style="{StaticResource CompactCardStyle}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Phục hồi từ gốc" Style="{StaticResource SmallMutedTextStyle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="QuickRestoreHotkeyCombo" SelectionChanged="QuickRestoreCombo_Changed">
                            <ComboBoxItem Content="Ctrl + Shift + Z"/>
                            <ComboBoxItem Content="Alt + R"/>
                            <ComboBoxItem Content="(Tắt)"/>
                            <ComboBoxItem Content="Tùy chỉnh..."/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
