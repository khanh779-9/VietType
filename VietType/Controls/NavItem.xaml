<UserControl x:Class="VietType.Controls.NavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38" Margin="0,2">
    <Border x:Name="Root"
            CornerRadius="8"
            Padding="10,0"
            Cursor="Hand"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Active Indicator Bar -->
            <Border x:Name="ActiveIndicator"
                    Width="3" Height="16"
                    CornerRadius="1.5"
                    Background="{DynamicResource AccentBrush}"
                    HorizontalAlignment="Left"
                    Margin="-10,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Icon -->
            <Path x:Name="Icon"
                  Width="16" Height="16"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="{DynamicResource SidebarIconBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SidebarIconHoverBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>

            <!-- Text -->
            <TextBlock x:Name="LabelText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Margin="10,0,0,0"
                       Text="Menu">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextHoverBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
