<UserControl x:Class="VietType.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="28">
    <Grid MouseLeftButtonUp="Grid_MouseLeftButtonUp" Cursor="Hand">
        <Border x:Name="Track" CornerRadius="14" Background="{DynamicResource BorderBrushSoft}"/>
        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="4"/>
    </Grid>
</UserControl>
