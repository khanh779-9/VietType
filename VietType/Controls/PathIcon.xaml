<UserControl x:Class="VietType.Controls.PathIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20">
    <Viewbox Stretch="Uniform">
        <Path x:Name="IconPath" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Stretch="Uniform" Data="{StaticResource IconInfo}"/>
    </Viewbox>
</UserControl>
