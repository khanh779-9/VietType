<controls:VietTypeWindow x:Class="VietType.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VietType.Controls"
        Title="Thông tin VietType"
        Width="490" Height="390"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/VietType;component/Resources/VietType.ico"
        Background="{DynamicResource WindowBrush}">

    <Border Padding="24,20" Background="{DynamicResource WindowBrush}">
        <DockPanel>
            <!-- Bottom Action Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hướng dẫn" Click="Guide_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Thư mục dữ liệu" Click="DataFolder_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Đóng" Click="Close_Click" Style="{StaticResource PrimaryButtonStyle}" Width="80" IsDefault="True"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <!-- Brand Hero -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <Path Width="30" Height="30" Stretch="Uniform" Fill="White" Data="{StaticResource IconApp}"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VietType" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            <Border x:Name="AdminTag" Margin="10,0,0,0" Padding="8,2" CornerRadius="5" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="AdminTagText" Text="Admin" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Bộ gõ tiếng Việt hiện đại cho Windows" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                        <TextBlock Text="Phiên bản 1.0.0 (x64) • .NET 8 • C# 12" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Details Card -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tác giả" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Khanh779-9" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kiểu gõ" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Telex, VNI, VIQR, Telex mở rộng" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bảng mã" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Unicode, VNI-Windows, TCVN3 (ABC)..." Foreground="{DynamicResource TextBrush}" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bản quyền" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="© 2026 VietType Project (MIT License)" Foreground="{DynamicResource TextBrush}" Margin="0,3"/>
                    </Grid>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</controls:VietTypeWindow>
